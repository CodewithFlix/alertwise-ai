# Microsoft Foundry Project Endpoint - Recommended for Agents League
AZURE_AI_PROJECT_ENDPOINT=project-endpoint-here
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o

# Azure OpenAI compatible settings
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview
